<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.17</Version>
    <PreviousPublishedVersion>0.1.14</PreviousPublishedVersion>
    <PublicationBaselineVerifiedUtc>2026-10-29T11:53:59Z</PublicationBaselineVerifiedUtc>
    <Authors>Robert Prokopczuk</Authors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Keep SDK Source Link roots aligned with the unconditional compiler PathMap locally and in CI. -->
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>
  <!-- Verified through nuget.org during preparation; build and pack never query the feed. -->
  <ItemGroup Label="PublicationBaseline">
    <PublicationBaselinePackage Include="Inceptus.DocumentEngine.Contracts" PublishedVersion="0.1.14" />
    <PublicationBaselinePackage Include="Inceptus.DocumentEngine.Runtime" PublishedVersion="0.1.14" />
    <PublicationBaselinePackage Include="Inceptus.DocumentEngine.Bpmn" PublishedVersion="0.1.14" />
    <PublicationBaselinePackage Include="Inceptus.DocumentEngine.Organizational" PublishedVersion="0.1.14" />
    <PublicationBaselinePackage Include="Inceptus.DocumentEngine.Canvas2D" PublishedVersion="0.1.14" />
    <PublicationBaselinePackage Include="Inceptus.DocumentEngine.Bpmn.Blazor" PublishedVersion="0.1.14" />
    <PublicationBaselinePackage Include="Inceptus.Bpmn.Integration" PublishedVersion="0.1.14" />
  </ItemGroup>
</Project>
