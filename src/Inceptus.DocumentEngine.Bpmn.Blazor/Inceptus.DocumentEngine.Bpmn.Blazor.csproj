<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <PackageId>Inceptus.DocumentEngine.Bpmn.Blazor</PackageId>
    <AssemblyName>Inceptus.DocumentEngine.Bpmn.Blazor</AssemblyName>
    <RootNamespace>Inceptus.DocumentEngine.Bpmn.Blazor</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>BPMN modeler components and browser presentation integration for the Inceptus Document Engine.</Description>
    <PackageTags>inceptus;document-engine;bpmn;blazor;modeler</PackageTags>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Razor's source generator embeds physical path literals before Roslyn applies PathMap.
         Release uses SDK-generated files so their directives can be mapped before compilation.
         Debug retains source generation and its normal Hot Reload support. -->
    <UseRazorSourceGenerator>false</UseRazorSourceGenerator>
    <!-- Windows qualifies /_/ directives with the current drive before recording authored documents.
         Map that virtual root too, using native separators so compiler prefix matching is exact. -->
    <PathMap>$(PathMap),$([System.IO.Path]::GetPathRoot('$(MSBuildProjectDirectory)'))_$([System.IO.Path]::DirectorySeparatorChar)=/_/</PathMap>
  </PropertyGroup>

  <Import Project="../../build/RazorSourcePaths.targets" />

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.JSInterop" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Inceptus.DocumentEngine.Contracts/Inceptus.DocumentEngine.Contracts.csproj" />
    <ProjectReference Include="../Inceptus.DocumentEngine.Runtime/Inceptus.DocumentEngine.Runtime.csproj" />
    <ProjectReference Include="../Inceptus.DocumentEngine.Canvas2D/Inceptus.DocumentEngine.Canvas2D.csproj" />
    <ProjectReference Include="../Inceptus.DocumentEngine.Bpmn/Inceptus.DocumentEngine.Bpmn.csproj" />
    <ProjectReference Include="../Inceptus.DocumentEngine.Organizational/Inceptus.DocumentEngine.Organizational.csproj" />
  </ItemGroup>
</Project>
