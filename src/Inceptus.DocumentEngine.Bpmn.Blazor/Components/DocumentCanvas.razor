@using Inceptus.DocumentEngine.Bpmn.Blazor
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ModelerStrings> Text
@using Inceptus.DocumentEngine.Bpmn.Blazor.Composition
@using Inceptus.DocumentEngine.Bpmn.Blazor.Presentation
@using Inceptus.DocumentEngine.Canvas2D.EditingSession
@using Inceptus.DocumentEngine.Canvas2D.Interaction
@using Inceptus.DocumentEngine.Canvas2D.Scene
@using Inceptus.DocumentEngine.Contracts.Canvas2D
@using Inceptus.DocumentEngine.Contracts.ContextMenus
@using Inceptus.DocumentEngine.Contracts.Deletion
@using Inceptus.DocumentEngine.Contracts.Diagnostics
@using Inceptus.DocumentEngine.Contracts.Documents
@using Inceptus.DocumentEngine.Contracts.Geometry
@using Inceptus.DocumentEngine.Contracts.Primitives
@using Inceptus.DocumentEngine.Contracts.Properties
@using Inceptus.DocumentEngine.Contracts.Profiles
@using Inceptus.DocumentEngine.Contracts.Toolbox
@using Inceptus.DocumentEngine.Contracts.Validation
@using Inceptus.DocumentEngine.Contracts.Visuals
@using System.Collections.Immutable
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject Microsoft.JSInterop.IJSRuntime JavaScript
@inject IServiceProvider Services

<main class="document-canvas-page"
      @onclick="CloseContextMenu"
      @onkeydown="HandleEditorKeyDownAsync">
    <section class="document-canvas-shell"
             data-presentation-status="@StatusValue"
             data-scene-status="@SceneStatusValue"
             data-scene-revision="@SceneRevision"
             data-document-id="@DocumentId"
             data-document-revision="@DocumentRevision"
             data-active-scope-id="@ActiveScopeId"
             data-scope-breadcrumb="@ScopeBreadcrumbValue"
             data-history-entry-count="@HistoryEntryCount"
             data-can-undo="@CanUndoValue"
             data-can-redo="@CanRedoValue"
             data-native-document-operation="@_nativeDocumentOperationStatus"
             data-native-document-error-code="@(_nativeDocumentOperationErrorCode ?? string.Empty)"
             data-new-diagram-operation="@_newDiagramOperationStatus"
             data-new-diagram-error-code="@(_newDiagramOperationErrorCode ?? string.Empty)"
             data-new-diagram-confirmation="@(_newDiagramConfirmationOpen ? "open" : "closed")"
             data-publish-operation="@_publishOperationStatus"
             data-publish-error-code="@(_publishOperationErrorCode ?? string.Empty)"
             data-publication-dialog="@(_publicationDialogOpen ? "open" : "closed")"
             data-publication-draft-valid="@(PublicationDraftIsValid ? "true" : "false")"
             data-active-canvas-id="@ActiveCanvasElementId"
             data-viewport-zoom="@ViewportZoom"
             data-viewport-pan-x="@ViewportPanX"
             data-viewport-pan-y="@ViewportPanY"
             data-zoom-percentage="@ZoomPercentage"
             data-can-zoom-out="@CanZoomOutValue"
             data-can-set-zoom-100="@CanSetZoomToActualSizeValue"
             data-can-zoom-in="@CanZoomInValue"
             data-context-menu-open="@ContextMenuOpenValue"
             data-context-menu-kind="@ContextMenuKindValue"
             data-context-target-visual-state-id="@ContextMenuTargetVisualStateId"
             data-context-target-semantic-element-id="@ContextMenuTargetSemanticElementId"
             data-open-scope-available="@OpenScopeAvailableValue"
             data-add-connector-point-available="@AddConnectorPointAvailableValue"
             data-delete-connector-point-available="@DeleteConnectorPointAvailableValue"
             data-delete-element-available="@DeleteElementAvailableValue"
             data-delete-connection-available="@DeleteConnectionAvailableValue"
             data-properties-available="@PropertiesAvailableValue"
             data-properties-form-open="@PropertiesFormOpenValue"
             data-properties-target-visual-state-id="@PropertiesTargetVisualStateId"
             data-properties-target-semantic-element-id="@PropertiesTargetSemanticElementId"
             data-properties-dirty="@PropertiesDirtyValue"
             data-properties-apply-status="@_propertiesApplyStatus"
             data-properties-authoritative-bounds="@PropertiesAuthoritativeBounds"
             data-properties-draft-bounds="@PropertiesDraftBounds"
             data-properties-data-field-count="@PropertiesDataFieldCount"
             data-properties-data-field-ids="@PropertiesDataFieldIds"
             data-model-view-properties-form-open="@ModelViewPropertiesFormOpenValue"
             data-model-view-properties-dirty="@ModelViewPropertiesDirtyValue"
             data-model-view-properties-apply-status="@_modelViewPropertiesApplyStatus"
             data-render-count="@SuccessfulRenderCount"
             data-projection-rule-count="@ProjectionRuleInvocationCount"
             data-layout-count="@LayoutInvocationCount"
             data-routing-count="@RoutingInvocationCount"
             data-scene-contribution-count="@SceneContributionInvocationCount"
             data-graphical-interaction-enabled="@GraphicalInteractionEnabled"
             data-selection-count="@SelectionCount"
             data-selected-visual-state-ids="@SelectedVisualStateIds"
             data-selected-scene-object-id="@SelectedSceneObjectId"
             data-hovered-scene-object-id="@HoveredSceneObjectId"
             data-selected-semantic-element-id="@SelectedSemanticElementId"
             data-hovered-semantic-element-id="@HoveredSemanticElementId"
             data-selected-visual-state-id="@SelectedVisualStateId"
             data-selected-document-bounds="@SelectedDocumentBounds"
             data-selected-route="@SelectedRoute"
             data-active-gesture-kind="@ActiveGestureKind"
             data-canvas-cursor="@CanvasCursor"
             data-interaction-diagnostic-code="@InteractionDiagnosticCode"
             data-canvas-css-width="@CssWidth"
             data-canvas-css-height="@CssHeight"
             data-device-pixel-ratio="@DevicePixelRatio"
             data-validation-state="@ValidationStateValue"
             data-validation-issue-count="@ValidationIssueCount"
             data-validation-error-count="@ValidationErrorCount"
             data-validation-warning-count="@ValidationWarningCount"
             data-validation-info-count="@ValidationInfoCount"
             data-can-validate="@CanValidateValue"
             data-issues-panel-open="@IssuesPanelOpenValue"
             data-issues-panel-left="@IssuesPanelLeft"
             data-issues-panel-top="@IssuesPanelTop"
             aria-label="@Text["Accessibility_DocumentPresentation"]">
        <div class="document-editor-layout">
            <ToolboxPanel Catalog="@ToolboxCatalog"
                          DomIdPrefix="@_domIdPrefix"
                          SelectedItemId="@_toolboxSelection.SelectedItemId"
                          SelectedItemIdChanged="SelectToolboxItemAsync" />
            <div class="document-editor-workspace">
        <div class="editor-toolbar" role="toolbar" aria-label="@Text["Accessibility_EditorToolbar"]">
            <nav class="scope-breadcrumb" aria-label="@Text["Accessibility_ProcessScope"]">
                @for (var index = 0; index < ScopeBreadcrumb.Length; index++)
                {
                    var segment = ScopeBreadcrumb[index];
                    if (index > 0)
                    {
                        <span class="scope-breadcrumb-separator" aria-hidden="true">›</span>
                    }
                    if (segment.IsActive)
                    {
                        <span class="scope-breadcrumb-current"
                              aria-current="page"
                              title="@segment.ScopeId.Value">@BreadcrumbLabel(segment)</span>
                    }
                    else
                    {
                        <button class="scope-breadcrumb-link"
                                type="button"
                                disabled="@(!CanNavigateScope)"
                                title="@segment.ScopeId.Value"
                                @onclick="() => NavigateToScopeAsync(segment.ScopeId)">@BreadcrumbLabel(segment)</button>
                    }
                }
            </nav>
            <div class="toolbar-group document-file-controls" role="group" aria-label="@Text["Accessibility_DocumentFile"]">
                <button id="@DomId("new-diagram")"
                        class="native-document-action new-diagram-action"
                        type="button"
                        disabled="@(!CanCreateNewDiagram)"
                        aria-label="@Text["Toolbar_NewDiagram"]"
                        title="@Text["Toolbar_NewDiagram"]"
                        @onclick="OpenNewDiagramConfirmation">
                    <span class="native-document-action-icon" aria-hidden="true">▧</span>
                </button>
                <label id="@DomId("import")"
                       class="native-document-action native-document-import-action"
                       for="@DomId("import-file")"
                       aria-disabled="@(!CanUseNativeDocumentTransfer)"
                       title="@Text["Toolbar_ImportHint"]">
                    <span class="native-document-action-icon" aria-hidden="true">⇩</span>
                    <InputFile @key="_nativeDocumentInputKey"
                               id="@DomId("import-file")"
                               class="native-document-file-input"
                               aria-label="@Text["Toolbar_Import"]"
                               disabled="@(!CanUseNativeDocumentTransfer)"
                               accept=".inceptus.json,application/json"
                               OnChange="ImportNativeDocumentAsync" />
                </label>
                <button id="@DomId("export")"
                        class="native-document-action"
                        type="button"
                        disabled="@(!CanUseNativeDocumentTransfer)"
                        aria-label="@Text["Toolbar_Export"]"
                        title="@Text["Toolbar_Export"]"
                        @onclick="ExportNativeDocumentAsync">
                    <span class="native-document-action-icon" aria-hidden="true">⇧</span>
                </button>
                <button id="@DomId("publish")"
                        class="native-document-action publish-action"
                        type="button"
                        disabled="@(!CanPublish)"
                        aria-label="@Text["Toolbar_Publish"]"
                        title="@Text["Toolbar_Publish"]"
                        @onclick="OpenPublicationDialog">
                    <span class="native-document-action-icon" aria-hidden="true">◈</span>
                </button>
            </div>
            <div class="toolbar-group history-controls" role="group" aria-label="@Text["Accessibility_History"]">
                <button id="@DomId("undo")"
                        type="button"
                        disabled="@(!CanUndo)"
                        title="@Text["Toolbar_Undo"]"
                        @onclick="UndoAsync">@Text["Toolbar_Undo"]</button>
                <button id="@DomId("redo")"
                        type="button"
                        disabled="@(!CanRedo)"
                        title="@Text["Toolbar_Redo"]"
                        @onclick="RedoAsync">@Text["Toolbar_Redo"]</button>
            </div>

            <div class="toolbar-group zoom-controls" role="group" aria-label="@Text["Accessibility_Zoom"]">
                <button id="@DomId("zoom-out")"
                        type="button"
                        disabled="@(!CanZoomOut)"
                        aria-label="@Text["Toolbar_ZoomOut"]"
                        title="@Text["Toolbar_ZoomOut"]"
                        @onclick="ZoomOutAsync">−</button>
                <button id="@DomId("zoom-100")"
                        class="zoom-percentage"
                        type="button"
                        disabled="@(!CanSetZoomToActualSize)"
                        aria-label="@Text["Toolbar_ZoomActualSize"]"
                        title="@Text["Toolbar_ZoomActualSize"]"
                        @onclick="SetZoomToActualSizeAsync">@ZoomPercentage%</button>
                <button id="@DomId("zoom-in")"
                        type="button"
                        disabled="@(!CanZoomIn)"
                        aria-label="@Text["Toolbar_ZoomIn"]"
                        title="@Text["Toolbar_ZoomIn"]"
                        @onclick="ZoomInAsync">+</button>
            </div>
            <div class="toolbar-group validation-controls" role="group" aria-label="@Text["Accessibility_ModelValidation"]">
                <button id="@DomId("validate")"
                        type="button"
                        disabled="@(!CanValidate)"
                        title="@Text["Toolbar_ValidateHint"]"
                        @onclick="ValidateAsync">@Text["Toolbar_Validate"]</button>
            </div>
        </div>

        <div id="@ContainerElementId" class="document-canvas-surface">
            <canvas id="@CanvasElementId"
                    class="@CanvasClass(CanvasElementId)"
                    tabindex="@CanvasTabIndex(CanvasElementId)"
                    aria-hidden="@CanvasAriaHidden(CanvasElementId)"
                    aria-label="@Text["Accessibility_RenderedDiagram"]"></canvas>
            <canvas id="@StandbyCanvasElementId"
                    class="@CanvasClass(StandbyCanvasElementId)"
                    tabindex="@CanvasTabIndex(StandbyCanvasElementId)"
                    aria-hidden="@CanvasAriaHidden(StandbyCanvasElementId)"
                    aria-label="@Text["Accessibility_RenderedDiagram"]"></canvas>
            @if (_state?.ContextMenu is { } contextMenu &&
                _propertiesDraft is null && _modelViewPropertiesDraft is null)
            {
                <div id="@(contextMenu.Kind == DocumentCanvasContextMenuKind.Background
                              ? DomId("model-context-menu")
                              : DomId("object-context-menu"))"
                     class="object-context-menu"
                     role="menu"
                     aria-label="@(contextMenu.Kind == DocumentCanvasContextMenuKind.Background
                                      ? Text["Accessibility_ModelActions"]
                                      : Text["Accessibility_ObjectActions"])"
                     @onclick:stopPropagation
                     @onpointerdown:stopPropagation
                     @onpointerup:stopPropagation
                     @onpointermove:stopPropagation
                     @onwheel:stopPropagation
                     @oncontextmenu:preventDefault
                     @oncontextmenu:stopPropagation
                     @onauxclick:preventDefault
                     @onauxclick:stopPropagation
                     style="left: @Format(contextMenu.CssPosition.X)px; top: @Format(contextMenu.CssPosition.Y)px;">
                    @if (contextMenu.Kind == DocumentCanvasContextMenuKind.Background)
                    {
                        @foreach (var group in contextMenu.BackgroundActions
                            .GroupBy(static action => action.GroupLabel, StringComparer.Ordinal))
                        {
                            <div class="model-context-submenu" role="none">
                                <button class="model-context-submenu-trigger"
                                        type="button"
                                        role="menuitem"
                                        aria-haspopup="menu">
                                    <span>@BackgroundGroupLabel(group)</span>
                                    <span aria-hidden="true">›</span>
                                </button>
                                <div class="model-context-submenu-items"
                                     role="menu"
                                     aria-label="@BackgroundGroupLabel(group)">
                                    @foreach (var action in group)
                                    {
                                        <button id="@BackgroundActionControlId(action.Id)"
                                                type="button"
                                                role="menuitem"
                                                data-background-action-id="@action.Id.Value"
                                                @onclick="() => ExecuteBackgroundContextActionAsync(action.Id)">@ModelerLabels.ActionLabel(Text, action.Id.Value, action.DisplayName)</button>
                                    }
                                </div>
                            </div>
                        }
                        <button id="@DomId("model-view-properties-action")"
                                type="button"
                                role="menuitem"
                                @onclick="OpenModelViewPropertiesAsync">@Text["Context_ModelProperties"]</button>
                    }
                    else
                    {
                        @foreach (var action in contextMenu.SemanticCommandActions)
                        {
                            <button id="@SemanticSceneCommandActionControlId(action.Id)"
                                    type="button"
                                    role="menuitem"
                                    data-semantic-scene-command-action-id="@action.Id.Value"
                                    @onclick="() => ExecuteSemanticSceneCommandContextActionAsync(action.Id)">@ModelerLabels.ActionLabel(Text, action.Id.Value, action.DisplayName)</button>
                        }
                        @foreach (var action in contextMenu.SemanticViewActions)
                        {
                            <button id="@SemanticSceneViewActionControlId(action.Id)"
                                    type="button"
                                    role="menuitem"
                                    data-semantic-scene-view-action-id="@action.Id.Value"
                                    @onclick="() => ExecuteSemanticSceneViewContextActionAsync(action.Id)">@ModelerLabels.ActionLabel(Text, action.Id.Value, action.DisplayName)</button>
                        }
                        @if (contextMenu.ScopeNavigationAction is { } scopeNavigationAction)
                        {
                            <button id="@DomId("open-scope-action")"
                                    type="button"
                                    role="menuitem"
                                    @onclick="ExecuteScopeNavigationContextActionAsync">@ScopeActionLabel(scopeNavigationAction)</button>
                        }
                        <button id="@DomId("properties-action")"
                                type="button"
                                role="menuitem"
                                disabled="@(!PropertiesAvailable)"
                                @onclick="OpenPropertiesAsync">@Text["Context_Properties"]</button>
                        @if (contextMenu.ConnectorRouteAction?.Kind is
                            Canvas2DConnectorRouteContextActionKind.AddPoint)
                        {
                            <button id="@DomId("add-connector-point-action")"
                                    type="button"
                                    role="menuitem"
                                    @onclick="ExecuteConnectorRouteContextActionAsync">@Text["Context_AddPoint"]</button>
                        }
                        else if (contextMenu.ConnectorRouteAction?.Kind is
                                 Canvas2DConnectorRouteContextActionKind.DeletePoint)
                        {
                            <button id="@DomId("delete-connector-point-action")"
                                    type="button"
                                    role="menuitem"
                                    @onclick="ExecuteConnectorRouteContextActionAsync">@Text["Context_DeletePoint"]</button>
                        }
                        @if (contextMenu.ConnectorAnchorAction?.Kind is
                            Canvas2DConnectorAnchorContextActionKind.AddAnchor)
                        {
                            @if (contextMenu.ConnectorAnchorAction.CanAdd(ConnectorAnchorRole.Source))
                            {
                                <button id="@DomId("add-connector-source-anchor-action")"
                                        type="button"
                                        role="menuitem"
                                        @onclick="() => ExecuteConnectorAnchorContextActionAsync(ConnectorAnchorRole.Source)">@Text["Context_AddSourceAnchor"]</button>
                            }
                            @if (contextMenu.ConnectorAnchorAction.CanAdd(ConnectorAnchorRole.Target))
                            {
                                <button id="@DomId("add-connector-target-anchor-action")"
                                        type="button"
                                        role="menuitem"
                                        @onclick="() => ExecuteConnectorAnchorContextActionAsync(ConnectorAnchorRole.Target)">@Text["Context_AddTargetAnchor"]</button>
                            }
                        }
                        else if (contextMenu.ConnectorAnchorAction is
                                 {
                                     Kind: Canvas2DConnectorAnchorContextActionKind.DeleteAnchor,
                                     CanDelete: true,
                                 })
                        {
                            <button id="@DomId("delete-connector-anchor-action")"
                                    type="button"
                                    role="menuitem"
                                    @onclick="() => ExecuteConnectorAnchorContextActionAsync(null)">@Text["Context_DeleteAnchor"]</button>
                        }
                        @if (contextMenu.NodeLabelAction is not null)
                        {
                            <button id="@DomId("reset-node-label-action")"
                                    type="button"
                                    role="menuitem"
                                    @onclick="ExecuteNodeLabelContextActionAsync">@Text["Context_ResetLabel"]</button>
                        }
                        @if (contextMenu.DeletionAction?.TargetKind is
                            DiagramDeletionTargetKind.Element)
                        {
                            <button id="@DomId("delete-element-action")"
                                    type="button"
                                    role="menuitem"
                                    @onclick="ExecuteDeletionContextActionAsync">@Text["Context_DeleteElement"]</button>
                        }
                        else if (contextMenu.DeletionAction?.TargetKind is
                                 DiagramDeletionTargetKind.Connection)
                        {
                            <button id="@DomId("delete-connection-action")"
                                    type="button"
                                    role="menuitem"
                                    @onclick="ExecuteDeletionContextActionAsync">@Text["Context_DeleteConnection"]</button>
                        }
                    }
                </div>
            }

            @if (_modelViewPropertiesDraft is { } modelViewDraft)
            {
                <div class="properties-backdrop"
                     aria-hidden="true"
                     @oncontextmenu:preventDefault></div>
                <form id="@DomId("model-view-properties-form")"
                      class="properties-form model-view-properties-form"
                      aria-label="@Text["Properties_ModelTitle"]"
                      @onsubmit="ApplyModelViewPropertiesAsync"
                      @onsubmit:preventDefault>
                    <header class="properties-form-header">
                        <h2>@Text["Properties_ModelTitle"]</h2>
                        <button id="@DomId("model-view-properties-close")"
                                class="properties-close"
                                type="button"
                                aria-label="@Text["Properties_CloseModel"]"
                                title="@Text["Properties_CloseModel"]"
                                disabled="@_modelViewPropertiesApplying"
                                @onclick="CancelModelViewProperties">×</button>
                    </header>

                    <fieldset data-property-group="profiles">
                        <legend>@Text["Properties_Profiles"]</legend>
                        @foreach (var profile in modelViewDraft.Profiles)
                        {
                            <section class="model-profile-row"
                                     data-model-profile-id="@profile.Definition.Id.Value">
                                <h3>@ModelerLabels.ProfileLabel(Text, profile.Definition)</h3>
                                <label>
                                    <input id="@ModelProfileAvailableControlId(profile.Definition.Id)"
                                           type="checkbox"
                                           checked="@profile.IsAvailable"
                                           disabled="@_modelViewPropertiesApplying"
                                           @onchange="eventArgs => UpdateModelProfileAvailability(profile.Definition.Id, eventArgs.Value)" />
                                    <span>@Text["Properties_Available"]</span>
                                </label>
                                <label>
                                    <input id="@ModelProfileVisibleControlId(profile.Definition.Id)"
                                           type="checkbox"
                                           checked="@profile.IsEffectivelyVisible"
                                           disabled="@(_modelViewPropertiesApplying || !profile.IsAvailable)"
                                           @onchange="eventArgs => UpdateModelProfileVisibility(profile.Definition.Id, eventArgs.Value)" />
                                    <span>@Text["Properties_Visible"]</span>
                                </label>
                            </section>
                        }
                    </fieldset>

                    @if (!string.IsNullOrWhiteSpace(modelViewDraft.Feedback))
                    {
                        <p class="properties-feedback" role="alert">@ModelViewFeedback(modelViewDraft)</p>
                    }

                    <footer class="properties-form-actions">
                        <button id="@DomId("model-view-properties-cancel")"
                                type="button"
                                disabled="@_modelViewPropertiesApplying"
                                @onclick="CancelModelViewProperties">@Text["Action_Cancel"]</button>
                        <button id="@DomId("model-view-properties-apply")"
                                class="primary"
                                type="submit"
                                disabled="@(_modelViewPropertiesApplying || modelViewDraft.IsStale)">@Text["Action_Apply"]</button>
                    </footer>
                </form>
            }

            @if (_propertiesDraft is { } draft)
            {
                <div class="properties-backdrop"
                     aria-hidden="true"
                     @oncontextmenu:preventDefault></div>
                <form id="@DomId("properties-form")"
                      class="properties-form"
                      aria-label="@Text["Accessibility_SelectedProperties"]"
                      @onsubmit="ApplyPropertiesAsync"
                      @onsubmit:preventDefault>
                    <header class="properties-form-header">
                        <h2>@Text["Properties_Title"]</h2>
                        <button id="@DomId("properties-close")"
                                class="properties-close"
                                type="button"
                                aria-label="@Text["Properties_Close"]"
                                title="@Text["Properties_Close"]"
                                disabled="@_propertiesApplying"
                                @onclick="CancelProperties">×</button>
                    </header>

                    <fieldset data-property-group="data">
                        <legend>@Text["Properties_Data"]</legend>
                        @foreach (var field in draft.DataFields)
                        {
                            <label>
                                @PropertyFieldLabel(field.Definition)
                                @switch (field.Definition.EditorKind)
                                {
                                    case ElementPropertyEditorKind.SingleLineText:
                                        <input id="@PropertiesFieldControlId(field.FieldId)"
                                               data-property-field-id="@field.FieldId.Value"
                                               type="text"
                                               value="@field.EditorValue"
                                               readonly="@(!field.CanEdit)"
                                               disabled="@_propertiesApplying"
                                               @oninput="eventArgs => UpdateDataDraftValue(field.FieldId, eventArgs.Value)" />
                                        break;
                                    case ElementPropertyEditorKind.Integer:
                                        <input id="@PropertiesFieldControlId(field.FieldId)"
                                               data-property-field-id="@field.FieldId.Value"
                                               type="number"
                                               step="1"
                                               inputmode="numeric"
                                               value="@field.EditorValue"
                                               readonly="@(!field.CanEdit)"
                                               disabled="@_propertiesApplying"
                                               @oninput="eventArgs => UpdateDataDraftValue(field.FieldId, eventArgs.Value)" />
                                        break;
                                    case ElementPropertyEditorKind.MultilineText:
                                        <textarea id="@PropertiesFieldControlId(field.FieldId)"
                                                  data-property-field-id="@field.FieldId.Value"
                                                  rows="5"
                                                  value="@field.EditorValue"
                                                  readonly="@(!field.CanEdit)"
                                                  disabled="@_propertiesApplying"
                                                  @oninput="eventArgs => UpdateDataDraftValue(field.FieldId, eventArgs.Value)"></textarea>
                                        break;
                                    case ElementPropertyEditorKind.Boolean:
                                        <input id="@PropertiesFieldControlId(field.FieldId)"
                                               data-property-field-id="@field.FieldId.Value"
                                               type="checkbox"
                                               checked="@ResolveBooleanEditorValue(field)"
                                               disabled="@(_propertiesApplying || !field.CanEdit)"
                                               @onchange="eventArgs => UpdateDataDraftValue(field.FieldId, eventArgs.Value)" />
                                        break;
                                    default:
                                        throw new InvalidOperationException(
                                            "The element Properties editor kind is unsupported.");
                                }
                            </label>
                        }
                    </fieldset>

                    <fieldset data-property-group="identity">
                        <legend>@Text["Properties_Identity"]</legend>
                        <label>@Text["Properties_SemanticId"]
                            <input id="@DomId("properties-semantic-id")"
                                   value="@draft.Authoritative.SemanticId.Value"
                                   readonly />
                        </label>
                        @if (draft.Authoritative.VisualStateId is { } propertyVisualStateId)
                        {
                            <label>@Text["Properties_VisualId"]
                                <input id="@DomId("properties-visual-id")"
                                       value="@propertyVisualStateId.Value"
                                       readonly />
                            </label>
                        }
                        <label>@Text["Properties_Type"]
                            <input id="@DomId("properties-type")"
                                   value="@draft.Authoritative.TypeId.Value"
                                   readonly />
                        </label>
                    </fieldset>

                    <fieldset data-property-group="visual">
                        <legend>@Text["Properties_Visual"]</legend>
                        <label>@Text["Properties_Placement"]
                            <input id="@DomId("properties-placement")"
                                   value="@Text[$"Placement_{draft.Authoritative.PlacementMode}"]"
                                   readonly />
                        </label>
                        @if (draft.Authoritative.CanEditBounds)
                        {
                            <div class="properties-grid">
                                <label>@Text["Properties_X"]
                                    <input id="@DomId("properties-x")"
                                           inputmode="decimal"
                                           value="@draft.X"
                                           disabled="@(_propertiesApplying || draft.IsSemanticDirty)"
                                           @oninput="eventArgs => UpdateVisualDraftValue(PropertiesVisualDraftField.X, eventArgs.Value)" />
                                </label>
                                <label>@Text["Properties_Y"]
                                    <input id="@DomId("properties-y")"
                                           inputmode="decimal"
                                           value="@draft.Y"
                                           disabled="@(_propertiesApplying || draft.IsSemanticDirty)"
                                           @oninput="eventArgs => UpdateVisualDraftValue(PropertiesVisualDraftField.Y, eventArgs.Value)" />
                                </label>
                                <label>@Text["Properties_Width"]
                                    <input id="@DomId("properties-width")"
                                           inputmode="decimal"
                                           value="@draft.Width"
                                           disabled="@(_propertiesApplying || draft.IsSemanticDirty)"
                                           @oninput="eventArgs => UpdateVisualDraftValue(PropertiesVisualDraftField.Width, eventArgs.Value)" />
                                </label>
                                <label>@Text["Properties_Height"]
                                    <input id="@DomId("properties-height")"
                                           inputmode="decimal"
                                           value="@draft.Height"
                                           disabled="@(_propertiesApplying || draft.IsSemanticDirty)"
                                           @oninput="eventArgs => UpdateVisualDraftValue(PropertiesVisualDraftField.Height, eventArgs.Value)" />
                                </label>
                            </div>
                        }
                        else if (draft.Authoritative.IsConnector)
                        {
                            <label>@Text["Properties_Source"]
                                <input id="@DomId("properties-source")"
                                       value="@draft.Authoritative.SourceId?.Value"
                                       readonly />
                            </label>
                            <label>@Text["Properties_Target"]
                                <input id="@DomId("properties-target")"
                                       value="@draft.Authoritative.TargetId?.Value"
                                       readonly />
                            </label>
                            <label>@Text["Properties_LabelPath"]
                                <input id="@DomId("properties-label-path-position")"
                                       value="@Format(draft.Authoritative.LabelPlacement!.PathPosition)"
                                       readonly />
                            </label>
                            <label>@Text["Properties_LabelOffsetX"]
                                <input id="@DomId("properties-label-offset-x")"
                                       value="@Format(draft.Authoritative.LabelPlacement!.Offset.X)"
                                       readonly />
                            </label>
                            <label>@Text["Properties_LabelOffsetY"]
                                <input id="@DomId("properties-label-offset-y")"
                                       value="@Format(draft.Authoritative.LabelPlacement!.Offset.Y)"
                                       readonly />
                            </label>
                        }
                    </fieldset>

                    @if (!string.IsNullOrWhiteSpace(draft.Feedback))
                    {
                        <p class="properties-feedback" role="alert">@PropertyFeedback(draft)</p>
                    }

                    <footer class="properties-form-actions">
                        <button id="@DomId("properties-cancel")"
                                type="button"
                                disabled="@_propertiesApplying"
                                @onclick="CancelProperties">@Text["Action_Cancel"]</button>
                        <button id="@DomId("properties-apply")"
                                class="primary"
                                type="submit"
                                disabled="@(_propertiesApplying || draft.IsStale || !draft.IsValid)">@Text["Action_Apply"]</button>
                    </footer>
                </form>
            }

            @if (_issuesPanel.IsOpen)
            {
                <aside id="@DomId("issues-panel")"
                       class="issues-floating-panel"
                       aria-label="@Text["Accessibility_ValidationIssues"]"
                       aria-live="polite"
                       style="@IssuesPanelStyle"
                       @onclick:stopPropagation
                       @onpointerdown:stopPropagation
                       @onpointermove:stopPropagation
                       @onpointerup:stopPropagation
                       @onpointercancel:stopPropagation
                       @onwheel:stopPropagation
                       @oncontextmenu:preventDefault
                       @oncontextmenu:stopPropagation
                       @onauxclick:preventDefault
                       @onauxclick:stopPropagation>
                    <header id="@DomId("issues-panel-header")"
                            class="issues-panel-header"
                            @onpointerdown="StartIssuesPanelMove"
                            @onpointerdown:preventDefault
                            @onpointermove="MoveIssuesPanel"
                            @onpointerup="EndIssuesPanelMove"
                            @onpointercancel="EndIssuesPanelMove"
                            @onlostpointercapture="CancelIssuesPanelMove">
                        <h2>@Text["Status_Issues"]</h2>
                    </header>
                    <button id="@DomId("issues-close")"
                            class="issues-close"
                            type="button"
                            aria-label="@Text["Status_CloseIssues"]"
                            title="@Text["Status_CloseIssues"]"
                            @onclick="CloseIssuesPanel">×</button>
                    <div class="issues-panel-summary issues-counts"
                         aria-label="@Text["Accessibility_IssueCounts"]">
                        <span data-severity="error">@Text["Status_Errors"] @ValidationErrorCount</span>
                        <span data-severity="warning">@Text["Status_Warnings"] @ValidationWarningCount</span>
                        <span data-severity="info">@Text["Status_Info"] @ValidationInfoCount</span>
                    </div>
                    <div class="issues-panel-body">
                        @if (CurrentValidation is null)
                        {
                            <p class="issues-empty">@Text["Status_NotValidatedSentence"]</p>
                        }
                        else if (CurrentValidation.Issues.IsEmpty)
                        {
                            <p class="issues-empty">@Text["Status_NoIssues"]</p>
                        }
                        else
                        {
                            <ul class="issues-list">
                                @foreach (var issue in CurrentValidation.Issues)
                                {
                                    <li>
                                        <button type="button"
                                                class="issue-row"
                                                data-issue-id="@issue.Id.Value"
                                                data-issue-code="@issue.Code"
                                                data-issue-severity="@issue.Severity.ToString().ToLowerInvariant()"
                                                disabled="@(issue.Target.VisualStateId is null)"
                                                @onclick="() => SelectValidationIssueAsync(issue.Id)">
                                            <span class="issue-severity" aria-hidden="true"></span>
                                            <span class="issue-content">
                                                <strong>@issue.Code</strong>
                                                <span>@issue.Message</span>
                                                <small>@ValidationTargetLabel(issue.Target)</small>
                                            </span>
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </aside>
            }
        </div>

        <footer id="@DomId("editor-status")" class="editor-status-row">
            <button id="@DomId("issues-toggle")"
                    class="issues-toggle"
                    type="button"
                    aria-controls="@DomId("issues-panel")"
                    aria-expanded="@IssuesPanelOpenValue"
                    @onclick="ToggleIssuesPanel">
                <span>@Text["Status_Issues"]</span>
                <span class="issues-disclosure" aria-hidden="true">@IssuesDisclosure</span>
            </button>
            <div class="canvas-presentation-status" role="status" aria-live="polite">
                <span class="status-indicator" aria-hidden="true"></span>
                <span>@StatusMessage</span>
            </div>
            @if (CurrentValidation is null)
            {
                <span class="validation-currency">@Text["Status_NotValidated"]</span>
            }
            <div class="issues-counts status-issue-counts"
                 aria-label="@Text["Accessibility_IssueCounts"]">
                <span data-severity="error">@Text["Status_Errors"] @ValidationErrorCount</span>
                <span data-severity="warning">@Text["Status_Warnings"] @ValidationWarningCount</span>
                <span data-severity="info">@Text["Status_Info"] @ValidationInfoCount</span>
            </div>
        </footer>

        @if (ErrorMessage is not null)
        {
            <p class="presentation-error" role="alert">@ErrorMessage</p>
        }
        @if (_nativeDocumentOperationErrorMessage is not null)
        {
            <p id="@DomId("native-document-error")"
               class="presentation-error native-document-error"
               role="alert">@Text[_nativeDocumentOperationErrorMessage]</p>
        }
        @if (_newDiagramOperationErrorMessage is not null)
        {
            <p id="@DomId("new-diagram-error")"
               class="presentation-error new-diagram-error"
               role="alert">@Text[_newDiagramOperationErrorMessage]</p>
        }
        @if (_publishOperationErrorMessage is not null)
        {
            <section id="@DomId("publish-error")"
                     class="presentation-error publish-error"
                     role="alert"
                     aria-labelledby="@DomId("publish-error-title")">
                <div class="publish-error-header">
                    <h2 id="@DomId("publish-error-title")">@Text[_publishOperationErrorHeading]</h2>
                    <button type="button"
                            aria-label="@Text["Publication_DismissFeedback"]"
                            @onclick="DismissPublishOperationError">@Text["Action_Dismiss"]</button>
                </div>
                <ul>
                    @foreach (var diagnostic in _publishOperationDiagnostics)
                    {
                        <li data-publish-diagnostic-code="@diagnostic.Code">
                            @if (PublishDiagnosticTarget(diagnostic) is { } target)
                            {
                                <strong>@target</strong>
                            }
                            <p>@diagnostic.Message</p>
                            @if (diagnostic.Context.TryGetValue("SuggestedAction", out var hint))
                            {
                                <p>@hint</p>
                            }
                            <small>@diagnostic.Code</small>
                        </li>
                    }
                </ul>
            </section>
        }
            </div>
        </div>
    </section>
    @if (_newDiagramConfirmationOpen)
    {
        <div class="new-diagram-confirmation-backdrop"
             @onclick="CancelNewDiagramConfirmation">
            <section id="@DomId("new-diagram-dialog")"
                     class="new-diagram-confirmation"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="@DomId("new-diagram-title")"
                     aria-describedby="@DomId("new-diagram-description")"
                     @onclick:stopPropagation>
                <h2 id="@DomId("new-diagram-title")">@Text["Dialog_NewDocument_Title"]</h2>
                <p id="@DomId("new-diagram-description")">
                    @Text["Dialog_NewDocument_Description"]
                </p>
                <div class="new-diagram-confirmation-actions">
                    <button id="@DomId("new-diagram-cancel")"
                            @ref="_newDiagramCancelButton"
                            type="button"
                            autofocus
                            disabled="@_newDiagramInProgress"
                            @onclick="CancelNewDiagramConfirmation">@Text["Action_Cancel"]</button>
                    <button id="@DomId("new-diagram-confirm")"
                            class="primary"
                            type="button"
                            disabled="@_newDiagramInProgress"
                            @onclick="ConfirmNewDiagramAsync">@Text["Toolbar_NewDiagram"]</button>
                </div>
            </section>
        </div>
    }
    @if (_publicationDialogOpen)
    {
        <div class="publication-dialog-backdrop"
             @onclick="CancelPublicationDialog">
            <section id="@DomId("publication-dialog")"
                     class="publication-dialog"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="@DomId("publication-title")"
                     @onclick:stopPropagation>
                <h2 id="@DomId("publication-title")">@Text["Publication_Title"]</h2>
                <div class="publication-fields">
                    <label for="@DomId("publication-code")">@Text["Field_Code"]</label>
                    <input id="@DomId("publication-code")"
                           @ref="_publicationCodeInput"
                           type="text"
                           autocomplete="off"
                           spellcheck="false"
                           aria-describedby="@DomId("publication-code-help")"
                           aria-invalid="@(!PublicationCodeIsValid)"
                           @bind="_publicationCodeDraft"
                           @bind:event="oninput" />
                    <span id="@DomId("publication-code-help")" class="publication-field-help">
                        @Text["Publication_CodeHelp"]
                    </span>

                    <label for="@DomId("publication-title-input")">@Text["Field_Title"]</label>
                    <input id="@DomId("publication-title-input")"
                           type="text"
                           aria-invalid="@(!PublicationTitleIsValid)"
                           @bind="_publicationTitleDraft"
                           @bind:event="oninput" />

                    <label for="@DomId("publication-description")">@Text["Field_Description"]</label>
                    <textarea id="@DomId("publication-description")"
                              rows="4"
                              @bind="_publicationDescriptionDraft"
                              @bind:event="oninput"></textarea>
                </div>
                <div class="publication-dialog-actions">
                    <button id="@DomId("publication-cancel")"
                            type="button"
                            disabled="@_publishInProgress"
                            @onclick="CancelPublicationDialog">@Text["Action_Cancel"]</button>
                    <button id="@DomId("publication-save")"
                            type="button"
                            disabled="@(!CanAcceptPublicationDraft)"
                            @onclick="SavePublicationDraftAsync">@Text["Action_Save"]</button>
                    <button id="@DomId("publication-publish")"
                            class="primary"
                            type="button"
                            disabled="@(!CanAcceptPublicationDraft)"
                            @onclick="PublishPublicationDraftAsync">@Text["Toolbar_Publish"]</button>
                </div>
            </section>
        </div>
    }
</main>

@code {
    [CascadingParameter(Name = "ModelerUICulture")]
    private System.Globalization.CultureInfo? RenderCulture { get; set; }

    [CascadingParameter]
    internal BpmnModelerFacade? ModelerFacade { get; set; }

    private readonly string _domIdPrefix = $"inceptus-{Guid.NewGuid():N}";
    private BpmnModelerCompositionFactory? _compositionFactory;
    private BpmnModelerCompositionFactory CompositionFactory =>
        _compositionFactory ??= ModelerFacade?.CompositionFactory ??
            new BpmnModelerCompositionFactory(
                () => Services.GetServices<IBpmnModelerStartupDocumentProvider>());
    private static ToolboxCatalog ToolboxCatalog =>
        BpmnModelerCompositionFactory.ToolboxCatalog;

    private string CanvasElementId => DomId("document-canvas");
    private string StandbyCanvasElementId => DomId("document-canvas-standby");
    private string ContainerElementId => DomId("document-canvas-container");
    private string DomId(string suffix) => $"{_domIdPrefix}-{suffix}";
    internal const string NativeDocumentContentType = "application/json";
    internal const string NativeDocumentFileName = "document.inceptus.json";
    internal const string PublishContentType = "application/zip";
    internal const string PublishFileName = "published-process.zip";
    internal const long MaximumNativeDocumentFileSize = 16L * 1024L * 1024L;
    internal const string NativeDocumentFileTooLargeCode =
        "CANVAS_NATIVE_DOCUMENT_FILE_TOO_LARGE";
    internal const string NativeDocumentFileTooLargeMessage =
        "Error_FileTooLarge";
    private readonly CancellationTokenSource _componentLifetime = new();
    private readonly ToolboxSelectionState _toolboxSelection = new();
    private readonly FloatingIssuesPanelState _issuesPanel = new();
    private DocumentCanvasHost? _host;
    private DocumentCanvasHostState? _state;
    private DocumentCanvasPropertiesDraft? _propertiesDraft;
    private DocumentCanvasModelViewPropertiesDraft? _modelViewPropertiesDraft;
    private IJSObjectReference? _issuesPanelModule;
    private IJSObjectReference? _issuesPanelPointerCapture;
    private bool _propertiesApplying;
    private string _propertiesApplyStatus = "idle";
    private bool _modelViewPropertiesApplying;
    private string _modelViewPropertiesApplyStatus = "idle";
    private bool _disposed;
    private bool _nativeDocumentImportInProgress;
    private bool _nativeDocumentExportInProgress;
    private int _nativeDocumentInputKey;
    private string _nativeDocumentOperationStatus = "idle";
    private string? _nativeDocumentOperationErrorCode;
    private string? _nativeDocumentOperationErrorMessage;
    private bool _newDiagramConfirmationOpen;
    private bool _newDiagramConfirmationFocusPending;
    private bool _newDiagramInProgress;
    private ElementReference _newDiagramCancelButton;
    private string _newDiagramOperationStatus = "idle";
    private string? _newDiagramOperationErrorCode;
    private string? _newDiagramOperationErrorMessage;
    private bool _publishInProgress;
    private string _publishOperationStatus = "idle";
    private string? _publishOperationErrorCode;
    private string? _publishOperationErrorMessage;
    private string _publishOperationErrorHeading = "Publication_PublishFailed";
    private ImmutableArray<Diagnostic> _publishOperationDiagnostics = [];
    private long? _publishOperationSessionVersion;
    private CancellationTokenSource? _publishOperationCancellation;
    private bool _publicationDialogOpen;
    private bool _publicationDialogFocusPending;
    private long _publicationSourceSessionVersion;
    private DocumentId? _publicationSourceDocumentId;
    private DocumentRevision? _publicationSourceRevision;
    private string _publicationCodeDraft = string.Empty;
    private string _publicationTitleDraft = string.Empty;
    private string _publicationDescriptionDraft = string.Empty;
    private ElementReference _publicationCodeInput;
    private readonly object _lifecycleSync = new();

    private string ActiveCanvasElementId =>
        _state?.ActiveCanvasElementId ?? CanvasElementId;

    private bool IsActiveCanvas(string canvasElementId) =>
        string.Equals(ActiveCanvasElementId, canvasElementId, StringComparison.Ordinal);

    private string CanvasClass(string canvasElementId) => IsActiveCanvas(canvasElementId)
        ? "document-canvas-buffer document-canvas-buffer-active"
        : "document-canvas-buffer";

    private int CanvasTabIndex(string canvasElementId) =>
        IsActiveCanvas(canvasElementId) ? 0 : -1;

    private string CanvasAriaHidden(string canvasElementId) =>
        IsActiveCanvas(canvasElementId) ? "false" : "true";

    private string SceneStatusValue => _state switch
    {
        { Session.IsClosed: true } or { IsDisposed: true } => "closed",
        { Session: not null } state => state.Session.Status.ToString().ToLowerInvariant(),
        _ => "uninitialized",
    };

    private string StatusValue => _state switch
    {
        { Session.Status: EditingSessionStatus.Ready, LatestPresentationSucceeded: false } =>
            "renderfaulted",
        { InitializationAttempted: true, IsInitialized: false } => "initializationfaulted",
        _ => SceneStatusValue,
    };

    private string SceneRevision =>
        (_state?.Session?.CurrentScene ?? _state?.Session?.LastKnownGoodScene)
        ?.SourceRevision.Value.ToString(
            System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;

    private string DocumentRevision =>
        _state?.Session?.DocumentRevision.Value.ToString(
            System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;

    private string DocumentId => _state?.Session?.DocumentId.Value ?? string.Empty;

    private string ActiveScopeId => _state?.Session?.ActiveScopeId.Value ?? string.Empty;

    private ImmutableArray<DocumentCanvasScopeBreadcrumbSegment> ScopeBreadcrumb =>
        _state?.ScopeBreadcrumb ?? DocumentCanvasScopeBreadcrumb.Empty;

    private string ScopeBreadcrumbValue => string.Join(
        " > ",
        ScopeBreadcrumb.Select(static segment => segment.Label));

    private bool CanNavigateScope =>
        _state?.Session is
        {
            IsClosed: false,
            Status: EditingSessionStatus.Ready,
            EditorState.ActiveGesture: null,
        } && !_publicationDialogOpen &&
        _propertiesDraft is null && _modelViewPropertiesDraft is null &&
        _state?.PropertiesFormOpen != true &&
        _state?.ModelViewPropertiesFormOpen != true;

    private string HistoryEntryCount =>
        _state?.Session?.HistoryStatus.EntryCount.ToString(
            System.Globalization.CultureInfo.InvariantCulture) ?? "0";

    private bool CanUndo =>
        _state?.Session is { IsClosed: false } session &&
        session.EditorState.ActiveGesture is null &&
        session.Status is EditingSessionStatus.Ready or EditingSessionStatus.RuntimeFaulted &&
        !_publicationDialogOpen &&
        !AnyPropertiesDirty &&
        !AnyPropertiesApplying &&
        session.HistoryStatus.CanUndo;

    private bool CanRedo =>
        _state?.Session is { IsClosed: false } session &&
        session.EditorState.ActiveGesture is null &&
        session.Status is EditingSessionStatus.Ready or EditingSessionStatus.RuntimeFaulted &&
        !_publicationDialogOpen &&
        !AnyPropertiesDirty &&
        !AnyPropertiesApplying &&
        session.HistoryStatus.CanRedo;

    private string CanUndoValue => CanUndo ? "true" : "false";

    private string CanRedoValue => CanRedo ? "true" : "false";

    private bool CanUseNativeDocumentTransfer =>
        !_nativeDocumentImportInProgress &&
        !_nativeDocumentExportInProgress &&
        !_newDiagramInProgress &&
        !_newDiagramConfirmationOpen &&
        !_publicationDialogOpen &&
        !_publishInProgress &&
        _state is
        {
            IsInitialized: true,
            IsDisposed: false,
            Session:
            {
                IsClosed: false,
                Status: EditingSessionStatus.Ready,
                EditorState.ActiveGesture: null,
            },
        } && _propertiesDraft is null && _modelViewPropertiesDraft is null &&
        _state.PropertiesFormOpen == false &&
        _state.ModelViewPropertiesFormOpen == false;

    private bool CanPublish => CanUseNativeDocumentTransfer;

    private bool PublicationCodeIsValid =>
        DocumentPublicationSnapshot.IsValidCode(_publicationCodeDraft);

    private bool PublicationTitleIsValid =>
        !string.IsNullOrWhiteSpace(_publicationTitleDraft);

    private bool PublicationDraftIsValid =>
        DocumentPublicationSnapshot.TryCreate(
            _publicationCodeDraft,
            _publicationTitleDraft,
            _publicationDescriptionDraft,
            out _);

    private bool CanAcceptPublicationDraft =>
        _publicationDialogOpen && !_publishInProgress && PublicationDraftIsValid;

    private bool CanCreateNewDiagram => CanUseNativeDocumentTransfer;

    private bool CanUseZoom =>
        _state is
        {
            IsInitialized: true,
            IsDisposed: false,
            SurfaceSize: not null,
            Session:
            {
                IsClosed: false,
                Status: EditingSessionStatus.Ready,
                CurrentScene: not null,
                EditorState.ActiveGesture: null,
            },
        } && !_publicationDialogOpen &&
        _propertiesDraft is null && _modelViewPropertiesDraft is null &&
        _state?.PropertiesFormOpen != true &&
        _state?.ModelViewPropertiesFormOpen != true;

    private bool CanZoomOut => CanUseZoom &&
        DocumentCanvasZoomPolicy.CanZoomOut(CurrentZoom);

    private bool CanZoomIn => CanUseZoom &&
        DocumentCanvasZoomPolicy.CanZoomIn(CurrentZoom);

    private bool CanSetZoomToActualSize => CanUseZoom &&
        !DocumentCanvasZoomPolicy.IsActualSize(CurrentZoom);

    private string CanZoomOutValue => CanZoomOut ? "true" : "false";

    private string CanZoomInValue => CanZoomIn ? "true" : "false";

    private string CanSetZoomToActualSizeValue =>
        CanSetZoomToActualSize ? "true" : "false";

    private double CurrentZoom => _state?.Session is { } session
        ? session.EditorState.Viewport.Zoom
        : DocumentCanvasZoomPolicy.ActualSize;

    private int ZoomPercentage => DocumentCanvasZoomPolicy.ToPercentage(CurrentZoom);

    private string ViewportZoom => Format(CurrentZoom);

    private string ViewportPanX => Format(
        _state?.Session?.EditorState.Viewport.Pan.X ?? 0d);

    private string ViewportPanY => Format(
        _state?.Session?.EditorState.Viewport.Pan.Y ?? 0d);

    private bool PropertiesAvailable =>
        _state?.Session is
        {
            IsClosed: false,
            Status: EditingSessionStatus.Ready,
            EditorState.ActiveGesture: null,
        } session &&
        ((_state.ContextMenu?.TargetVisualStateId is { } targetVisualStateId &&
          session.EditorState.Selection.Contains(targetVisualStateId)) ||
         (_state.ContextMenu?.TargetSemanticElementId is { } targetSemanticElementId &&
          session.EditorState.Selection.IsEmpty &&
          session.EditorState.SemanticSceneSelection == targetSemanticElementId));

    private string PropertiesAvailableValue => PropertiesAvailable ? "true" : "false";

    private string ContextMenuOpenValue =>
        _state?.ContextMenu is not null && _propertiesDraft is null &&
        _modelViewPropertiesDraft is null
            ? "true"
            : "false";

    private string ContextMenuKindValue => _state?.ContextMenu?.Kind switch
    {
        DocumentCanvasContextMenuKind.Element => "element",
        DocumentCanvasContextMenuKind.Background => "background",
        _ => string.Empty,
    };

    private string ContextMenuTargetVisualStateId =>
        _state?.ContextMenu?.TargetVisualStateId?.Value ?? string.Empty;

    private string ContextMenuTargetSemanticElementId =>
        _state?.ContextMenu?.TargetSemanticElementId?.Value ?? string.Empty;

    private string OpenScopeAvailableValue =>
        _state?.ContextMenu?.ScopeNavigationAction is not null ? "true" : "false";

    private string AddConnectorPointAvailableValue =>
        _state?.ContextMenu?.ConnectorRouteAction?.Kind is
            Canvas2DConnectorRouteContextActionKind.AddPoint
