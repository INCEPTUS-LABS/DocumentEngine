    private void UpdateVisualDraftValue(PropertiesVisualDraftField field, object? value)
    {
        if (_propertiesDraft is not { } draft ||
            _propertiesApplying ||
            !draft.Authoritative.CanEditBounds ||
            draft.IsSemanticDirty)
        {
            return;
        }

        var text = value?.ToString() ?? string.Empty;
        switch (field)
        {
            case PropertiesVisualDraftField.X:
                draft.X = text;
                break;
            case PropertiesVisualDraftField.Y:
                draft.Y = text;
                break;
            case PropertiesVisualDraftField.Width:
                draft.Width = text;
                break;
            case PropertiesVisualDraftField.Height:
                draft.Height = text;
                break;
            default:
                throw new ArgumentOutOfRangeException(nameof(field), field, null);
        }

        PublishUpdatedPropertiesDraft(draft);
    }

    private void PublishUpdatedPropertiesDraft(DocumentCanvasPropertiesDraft draft)
    {
        draft.Feedback = draft.TryValidate(out _, out var validationMessages)
            ? null
            : string.Join(" ", validationMessages);
        _propertiesApplyStatus = draft.IsDirty ? "dirty" : "idle";
        if (_host is { } host)
        {
            _ = TryPublishPropertiesFormState(host, draft);
        }
    }

    private string PropertiesFieldControlId(ElementPropertyFieldId fieldId) =>
        DomId($"properties-data-field-{fieldId.Value}");

    private static readonly string[] CompactPropertiesDataFieldOrder =
        ["code", "element-number", "name", "description"];

    private static bool HasCompactPropertiesDataLayout(ImmutableArray<DocumentCanvasDataPropertyDraft> fields) =>
        CompactPropertiesDataFieldOrder.All(id => fields.Any(field => field.FieldId.Value == id));

    // Order the rendered controls, not just their CSS positions, so keyboard order matches the rows.
    private static IEnumerable<DocumentCanvasDataPropertyDraft> PropertiesDataFieldsForLayout(
        ImmutableArray<DocumentCanvasDataPropertyDraft> fields,
        bool compactDataLayout) =>
        compactDataLayout
            ? CompactPropertiesDataFieldOrder.Select(id => fields.Single(field => field.FieldId.Value == id))
                .Concat(fields.Where(field => !CompactPropertiesDataFieldOrder.Contains(field.FieldId.Value)))
            : fields;

    private static bool ResolveBooleanEditorValue(DocumentCanvasDataPropertyDraft field) =>
        field.TryParseBoolean(out var value) && value;

    private async Task ApplyPropertiesAsync()
    {
        if (_propertiesDraft is not { } draft || _propertiesApplying || _host is not { } host)
        {
            return;
        }

        _propertiesApplying = true;
        _propertiesApplyStatus = "applying";
        draft.Feedback = null;
        try
        {
            if (!TryPublishPropertiesFormState(host, draft))
            {
                return;
            }

            var result = await host.ApplyPropertiesAsync(draft, _componentLifetime.Token);
            var current = host.CaptureState();
            RefreshHostState(host, current);
            if (!ReferenceEquals(_propertiesDraft, draft) ||
                !IsCurrentPropertiesTarget(
                    current,
                    draft.Authoritative))
            {
                SynchronizePropertiesFormAfterStaleCallback(host, draft);
                return;
            }

            _propertiesApplyStatus = result.Status.ToString().ToLowerInvariant();
            if (result.Succeeded)
            {
                CancelProperties();
            }
            else
            {
                draft.Feedback = result.Message ?? "Properties_Failed";
                draft.FeedbackDiagnostic = result.Diagnostics.FirstOrDefault();
                _ = TryPublishPropertiesFormState(host, draft);
            }
        }
        catch (OperationCanceledException) when (_componentLifetime.IsCancellationRequested)
        {
            // Component disposal owns this cancellation. The host preserves any
            // authoritative command outcome and its finally block releases its gate.
        }
        finally
        {
            _propertiesApplying = false;
            RefreshHostState(host);
            ReconcilePropertiesForm();
        }
    }

    private void ReconcilePropertiesForm()
    {
        if (_host is not { } host || _state?.Session is not { } session)
        {
            return;
        }

        if (_propertiesDraft is not { } draft)
        {
            if (!_state.PropertiesFormOpen)
            {
                return;
            }

            if (session.Status == EditingSessionStatus.Rebuilding || _propertiesApplying)
            {
                return;
            }

            if (host.TryCaptureCurrentPropertiesForm(out var current) && current is not null)
            {
                _propertiesDraft = new DocumentCanvasPropertiesDraft(current);
                _propertiesApplyStatus = "idle";
                _ = TryPublishPropertiesFormState(host, _propertiesDraft);
            }

            return;
        }

        if (!_state.PropertiesFormOpen)
        {
            CancelProperties();
            return;
        }

        if (!IsCurrentPropertiesTarget(_state, draft.Authoritative))
        {
            SynchronizePropertiesFormAfterStaleCallback(host, draft);
            return;
        }

        if (session.Status == EditingSessionStatus.Rebuilding || _propertiesApplying)
        {
            return;
        }

        if (session.DocumentRevision == draft.Authoritative.Revision)
        {
            return;
        }

        if (draft.IsDirty)
        {
            draft.IsStale = true;
            draft.Feedback =
                "The selected object changed after the form was opened. Cancel and reopen Properties.";
            _propertiesApplyStatus = "stale";
            _ = TryPublishPropertiesFormState(host, draft);
            return;
        }

        if (host.TryCaptureCurrentPropertiesForm(out var refreshed) &&
            refreshed is not null)
        {
            _propertiesDraft = new DocumentCanvasPropertiesDraft(refreshed);
            _propertiesApplyStatus = "idle";
            _ = TryPublishPropertiesFormState(host, _propertiesDraft);
        }
        else
        {
            SynchronizePropertiesFormAfterStaleCallback(host, draft);
        }
    }

    private bool TryPublishPropertiesFormState(
        DocumentCanvasHost host,
        DocumentCanvasPropertiesDraft? draft)
    {
        if (draft is not null && host.UpdatePropertiesFormState(
                isOpen: true,
                draft.Authoritative.VisualStateId,
                draft.IsDirty,
                targetSemanticElementId: draft.Authoritative.VisualStateId is null
                    ? draft.Authoritative.SemanticId
                    : null,
                targetPresentationId: draft.Authoritative.SpatialRegion?.Id))
        {
            RefreshHostState(host);
            return true;
        }

        SynchronizePropertiesFormAfterStaleCallback(host, draft);
        return false;
    }

    private void SynchronizePropertiesFormAfterStaleCallback(
        DocumentCanvasHost host,
        DocumentCanvasPropertiesDraft? rejectedDraft)
    {
        var current = host.CaptureState();
        RefreshHostState(host, current);
        if (_propertiesDraft is { } existingDraft &&
            IsCurrentPropertiesTarget(current, existingDraft.Authoritative))
        {
            if (!ReferenceEquals(existingDraft, rejectedDraft))
            {
                return;
            }

            if (host.TryCaptureCurrentPropertiesForm(out var replacement) &&
                replacement is not null)
            {
                var replacementDraft = new DocumentCanvasPropertiesDraft(replacement);
                _propertiesDraft = replacementDraft;
                _propertiesApplying = false;
                _propertiesApplyStatus = "idle";
                RefreshHostState(host);
                return;
            }
        }

        // A failed stale publication must never close a newer singleton target.
        // The host is authoritative for whether a form is still open; session
        // notifications reconcile any target installed after this atomic capture.
        _propertiesDraft = null;
        _propertiesApplying = false;
        _propertiesApplyStatus = "idle";
        RefreshHostState(host);
    }

    private void RefreshHostState(
        DocumentCanvasHost host,
        DocumentCanvasHostState? captured = null)
    {
        lock (_lifecycleSync)
        {
            if (!_disposed && ReferenceEquals(_host, host))
            {
                _state = captured ?? host.CaptureState();
            }
        }

    }

    private static bool IsCurrentPropertiesTarget(
        DocumentCanvasHostState state,
        DocumentCanvasPropertySnapshot target) =>
        state.PropertiesFormOpen &&
        state.Session is { IsClosed: false } session &&
        (target.VisualStateId is { } targetVisualStateId
            ? state.PropertiesTargetVisualStateId == targetVisualStateId &&
              state.PropertiesTargetSemanticElementId is null &&
              session.EditorState.Selection.Contains(targetVisualStateId) &&
              // A rebuild temporarily removes the Scene, not the selected spatial target.
              (session.Status == EditingSessionStatus.Rebuilding ||
               session.CurrentScene?.GetVisualRegion(targetVisualStateId)?.Id ==
                   target.SpatialRegion?.Id)
            : state.PropertiesTargetVisualStateId is null &&
              state.PropertiesTargetSemanticElementId == target.SemanticId &&
              session.EditorState.Selection.IsEmpty &&
              session.EditorState.SemanticSceneSelection == target.SemanticId);

