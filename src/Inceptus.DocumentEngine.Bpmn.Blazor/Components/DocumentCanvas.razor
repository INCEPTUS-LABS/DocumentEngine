    private string DeleteConnectorPointAvailableValue =>
        _state?.ContextMenu?.ConnectorRouteAction?.Kind is
            Canvas2DConnectorRouteContextActionKind.DeletePoint
                ? "true"
                : "false";

    private string DeleteElementAvailableValue =>
        _state?.ContextMenu?.DeletionAction?.TargetKind is
            DiagramDeletionTargetKind.Element
