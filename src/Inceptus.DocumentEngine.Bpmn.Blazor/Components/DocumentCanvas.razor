            _state = _host.CaptureState();
        }

        SynchronizeIssuesPanelSurface();
        ReconcilePropertiesForm();
        ReconcileModelViewPropertiesForm();
        ReconcilePublicationDialog();
        ReconcilePublishOperation();

        StateHasChanged();
    });

