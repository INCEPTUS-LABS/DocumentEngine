    private async Task ApplyModelViewPropertiesAsync()
    {
        if (_modelViewPropertiesDraft is not { } draft ||
            _modelViewPropertiesApplying ||
            _host is not { } host)
        {
            return;
        }

        _modelViewPropertiesApplying = true;
        _modelViewPropertiesApplyStatus = "applying";
        draft.Feedback = null;
        try
        {
            if (!TryPublishModelViewPropertiesFormState(host, draft))
            {
                return;
            }

            var result = await host.ApplyModelViewPropertiesAsync(
                draft,
                _componentLifetime.Token);
            var current = host.CaptureState();
            RefreshHostState(host, current);
            _modelViewPropertiesApplyStatus = result.Status.ToString().ToLowerInvariant();
            if (result.Succeeded && result.Authoritative is not null)
            {
                _modelViewPropertiesDraft = null;
                return;
            }

            if (!ReferenceEquals(_modelViewPropertiesDraft, draft) ||
                !IsCurrentModelViewPropertiesForm(
                    current,
                    draft.Authoritative.ViewContext))
            {
                SynchronizeModelViewPropertiesFormAfterStaleCallback(host);
                return;
            }

            draft.Feedback = result.Message ?? "Properties_ModelFailed";
            draft.FeedbackDiagnostic = result.Diagnostics.FirstOrDefault();
            _ = TryPublishModelViewPropertiesFormState(host, draft);
        }
        catch (OperationCanceledException) when (_componentLifetime.IsCancellationRequested)
        {
            // Component disposal owns this cancellation. The host preserves any
            // authoritative command outcome and releases its host gate.
        }
        finally
        {
            _modelViewPropertiesApplying = false;
            RefreshHostState(host);
            ReconcileModelViewPropertiesForm();
        }
    }

    private bool TryPublishModelViewPropertiesFormState(
        DocumentCanvasHost host,
        DocumentCanvasModelViewPropertiesDraft draft)
    {
        if (host.UpdateModelViewPropertiesFormState(
                isOpen: true,
                draft.IsDirty))
        {
            RefreshHostState(host);
            return true;
        }

        SynchronizeModelViewPropertiesFormAfterStaleCallback(host);
        return false;
    }

    private void ReconcileModelViewPropertiesForm()
    {
        if (_host is not { } host || _state?.Session is not { } session)
        {
            return;
        }

        if (_modelViewPropertiesDraft is not { } draft)
        {
            if (!_state.ModelViewPropertiesFormOpen ||
                session.Status == EditingSessionStatus.Rebuilding ||
                _modelViewPropertiesApplying)
            {
                return;
            }

            if (host.TryCaptureCurrentModelViewPropertiesForm(out var current) &&
                current is not null)
            {
                _modelViewPropertiesDraft =
                    new DocumentCanvasModelViewPropertiesDraft(current);
                _modelViewPropertiesApplyStatus = "idle";
            }

            return;
        }

        if (!_state.ModelViewPropertiesFormOpen)
        {
            _modelViewPropertiesDraft = null;
            _modelViewPropertiesApplying = false;
            _modelViewPropertiesApplyStatus = "idle";
            return;
        }

        if (session.Status == EditingSessionStatus.Rebuilding ||
            _modelViewPropertiesApplying)
        {
            return;
        }

        if (!host.TryCaptureCurrentModelViewPropertiesForm(out var refreshed) ||
            refreshed is null ||
            refreshed.ScopeId != draft.Authoritative.ScopeId)
        {
            SynchronizeModelViewPropertiesFormAfterStaleCallback(host);
            return;
        }

        if (ModelViewSnapshotsEqual(refreshed, draft.Authoritative))
        {
            return;
        }

        if (draft.IsDirty)
        {
            draft.IsStale = true;
            draft.Feedback =
                "The model or active view changed after the form was opened. Cancel and reopen View and model properties.";
            _modelViewPropertiesApplyStatus = "stale";
            _ = TryPublishModelViewPropertiesFormState(host, draft);
            return;
        }

        _modelViewPropertiesDraft = new DocumentCanvasModelViewPropertiesDraft(refreshed);
        _modelViewPropertiesApplyStatus = "idle";
    }

    private void SynchronizeModelViewPropertiesFormAfterStaleCallback(
        DocumentCanvasHost host)
    {
        var current = host.CaptureState();
        RefreshHostState(host, current);
        if (current.ModelViewPropertiesFormOpen &&
            host.TryCaptureCurrentModelViewPropertiesForm(out var replacement) &&
            replacement is not null)
        {
            _modelViewPropertiesDraft =
                new DocumentCanvasModelViewPropertiesDraft(replacement);
            _modelViewPropertiesApplying = false;
            _modelViewPropertiesApplyStatus = "idle";
            return;
        }

        _modelViewPropertiesDraft = null;
        _modelViewPropertiesApplying = false;
        _modelViewPropertiesApplyStatus = "idle";
    }

    private static bool ModelViewSnapshotsEqual(
        DocumentCanvasModelViewPropertiesSnapshot left,
        DocumentCanvasModelViewPropertiesSnapshot right) =>
        left.DocumentId == right.DocumentId &&
        left.Revision == right.Revision &&
        left.ScopeId == right.ScopeId &&
        Equals(left.AppearanceMetadata, right.AppearanceMetadata) &&
        left.Profiles.Length == right.Profiles.Length &&
        left.Profiles.Zip(right.Profiles).All(static pair =>
            pair.First.Definition.Id == pair.Second.Definition.Id &&
            pair.First.IsAvailable == pair.Second.IsAvailable &&
            pair.First.IsPreferredVisible == pair.Second.IsPreferredVisible);

    private static bool IsCurrentModelViewPropertiesForm(
        DocumentCanvasHostState state,
        PresentationViewContext viewContext) =>
        state.ModelViewPropertiesFormOpen &&
        state.Session is { IsClosed: false } session &&
        session.PresentationContext == viewContext;

