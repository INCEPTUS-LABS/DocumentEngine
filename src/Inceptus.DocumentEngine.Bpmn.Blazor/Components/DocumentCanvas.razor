    private int PropertiesDataFieldCount => _propertiesDraft?.DataFields.Length ?? 0;

    private string PropertiesDataFieldIds => _propertiesDraft is { } draft
        ? string.Join(",", draft.DataFields.Select(static item => item.FieldId.Value))
        : string.Empty;

    private string ModelViewPropertiesFormOpenValue =>
        _modelViewPropertiesDraft is null ? "false" : "true";

    private string ModelViewPropertiesDirtyValue =>
        ModelViewPropertiesDirty ? "true" : "false";

    private int SuccessfulRenderCount => _state?.SuccessfulRenderCount ?? 0;

    private int ProjectionRuleInvocationCount =>
        _state?.PipelineCounters?.ProjectionRuleInvocationCount ?? 0;

    private int LayoutInvocationCount => _state?.PipelineCounters?.LayoutInvocationCount ?? 0;

    private int RoutingInvocationCount => _state?.PipelineCounters?.RoutingInvocationCount ?? 0;

    private int SceneContributionInvocationCount =>
        _state?.PipelineCounters?.SceneContributionInvocationCount ?? 0;

    private string GraphicalInteractionEnabled =>
        _state?.Session?.IsGraphicalInteractionEnabled == true ? "true" : "false";

    private int SelectionCount => _state?.Session?.EditorState.Selection.Length ?? 0;

    private string SelectedVisualStateIds => _state?.Session is { } session
        ? string.Join(
            ",",
            session.EditorState.Selection
                .Select(static id => id.Value)
                .OrderBy(static value => value, StringComparer.Ordinal))
        : string.Empty;

    private string SelectedSceneObjectId =>
        ResolveSelectedSceneObject()?.Id.Value ?? string.Empty;

    private string HoveredSceneObjectId =>
        _state?.Session?.EditorState.HoveredObjectId?.Value ?? string.Empty;

    private string SelectedSemanticElementId =>
        ResolveSelectedSceneObject()?.Origin.SemanticElementId?.Value ?? string.Empty;

    private string HoveredSemanticElementId => ResolveSemanticElementId(
        _state?.Session?.EditorState.HoveredObjectId);

    private string SelectedVisualStateId => ResolveSelectedVisualStateId()?.Value ?? string.Empty;

    private string SelectedDocumentBounds
    {
        get
        {
            var item = ResolveSelectedPersistentItem(preferPath: false);
            return item is null
                ? string.Empty
                : string.Join(",",
                    Format(item.Bounds.X),
                    Format(item.Bounds.Y),
                    Format(item.Bounds.Width),
                    Format(item.Bounds.Height));
        }
    }

    private string SelectedRoute
    {
        get
        {
            var item = ResolveSelectedPersistentItem(preferPath: true);
            if (item?.Geometry.Kind != Canvas2DSceneGeometryKind.Path)
            {
                return string.Empty;
            }

            return string.Join(
