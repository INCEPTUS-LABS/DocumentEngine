    private bool AnyPropertiesDirty => PropertiesDirty || ModelViewPropertiesDirty;

    private bool AnyPropertiesApplying =>
        _propertiesApplying || _modelViewPropertiesApplying;

    private string PropertiesDirtyValue => PropertiesDirty ? "true" : "false";

    private string PropertiesFormOpenValue => _propertiesDraft is null ? "false" : "true";

    private string PropertiesTargetVisualStateId =>
        _propertiesDraft?.Authoritative.VisualStateId?.Value ?? string.Empty;

    private string PropertiesTargetSemanticElementId =>
