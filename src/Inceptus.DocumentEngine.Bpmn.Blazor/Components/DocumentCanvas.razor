    private void ReconcilePropertiesForm()
    {
        if (_host is not { } host || _state?.Session is not { } session)
        {
            return;
        }

        if (_propertiesDraft is not { } draft)
        {
            if (!_state.PropertiesFormOpen)
            {
                return;
            }

            if (session.Status == EditingSessionStatus.Rebuilding || _propertiesApplying)
            {
                return;
            }

            if (host.TryCaptureCurrentPropertiesForm(out var current) && current is not null)
            {
                _propertiesDraft = new DocumentCanvasPropertiesDraft(current);
                _propertiesApplyStatus = "idle";
                _ = TryPublishPropertiesFormState(host, _propertiesDraft);
            }

            return;
        }

        if (!_state.PropertiesFormOpen)
        {
            CancelProperties();
            return;
        }

        if (!IsCurrentPropertiesTarget(_state, draft.Authoritative))
        {
            SynchronizePropertiesFormAfterStaleCallback(host, draft);
            return;
        }

        if (session.Status == EditingSessionStatus.Rebuilding || _propertiesApplying)
        {
            return;
        }

        if (session.DocumentRevision == draft.Authoritative.Revision)
        {
            return;
        }

        if (draft.IsDirty)
        {
            draft.IsStale = true;
            draft.Feedback =
                "The selected object changed after the form was opened. Cancel and reopen Properties.";
            _propertiesApplyStatus = "stale";
            _ = TryPublishPropertiesFormState(host, draft);
            return;
        }

        if (host.TryCaptureCurrentPropertiesForm(out var refreshed) &&
            refreshed is not null)
        {
            _propertiesDraft = new DocumentCanvasPropertiesDraft(refreshed);
            _propertiesApplyStatus = "idle";
            _ = TryPublishPropertiesFormState(host, _propertiesDraft);
        }
        else
        {
            SynchronizePropertiesFormAfterStaleCallback(host, draft);
        }
    }

    private bool TryPublishPropertiesFormState(
        DocumentCanvasHost host,
        DocumentCanvasPropertiesDraft? draft)
    {
        if (draft is not null && host.UpdatePropertiesFormState(
                isOpen: true,
                draft.Authoritative.VisualStateId,
                draft.IsDirty,
                targetSemanticElementId: draft.Authoritative.VisualStateId is null
                    ? draft.Authoritative.SemanticId
                    : null,
                targetPresentationId: draft.Authoritative.SpatialRegion?.Id))
        {
            RefreshHostState(host);
            return true;
        }

        SynchronizePropertiesFormAfterStaleCallback(host, draft);
        return false;
    }

    private void SynchronizePropertiesFormAfterStaleCallback(
        DocumentCanvasHost host,
        DocumentCanvasPropertiesDraft? rejectedDraft)
    {
        var current = host.CaptureState();
        RefreshHostState(host, current);
        if (_propertiesDraft is { } existingDraft &&
            IsCurrentPropertiesTarget(current, existingDraft.Authoritative))
        {
            if (!ReferenceEquals(existingDraft, rejectedDraft))
            {
                return;
            }

            if (host.TryCaptureCurrentPropertiesForm(out var replacement) &&
                replacement is not null)
            {
                var replacementDraft = new DocumentCanvasPropertiesDraft(replacement);
                _propertiesDraft = replacementDraft;
                _propertiesApplying = false;
                _propertiesApplyStatus = "idle";
                RefreshHostState(host);
                return;
            }
        }

        // A failed stale publication must never close a newer singleton target.
        // The host is authoritative for whether a form is still open; session
        // notifications reconcile any target installed after this atomic capture.
        _propertiesDraft = null;
        _propertiesApplying = false;
        _propertiesApplyStatus = "idle";
        RefreshHostState(host);
    }

    private void RefreshHostState(
        DocumentCanvasHost host,
        DocumentCanvasHostState? captured = null)
    {
        lock (_lifecycleSync)
        {
            if (!_disposed && ReferenceEquals(_host, host))
            {
                _state = captured ?? host.CaptureState();
            }
        }

        SynchronizeIssuesPanelSurface();
    }

    private void SynchronizeIssuesPanelSurface()
    {
        if (_state?.SurfaceSize is { } surfaceSize)
        {
            _issuesPanel.ResizeSurface(surfaceSize.CssWidth, surfaceSize.CssHeight);
        }
    }

    private async ValueTask SynchronizeIssuesPanelPointerCaptureAsync()
    {
        if (_disposed)
        {
            return;
        }

        if (_issuesPanel.IsOpen)
        {
            if (_issuesPanelPointerCapture is not null)
            {
                return;
            }

            _issuesPanelModule ??= await JavaScript.InvokeAsync<IJSObjectReference>(
                "import",
                _componentLifetime.Token,
                "./_content/Inceptus.DocumentEngine.Bpmn.Blazor/inceptus.presentation.js");
            var pointerCapture = await _issuesPanelModule.InvokeAsync<IJSObjectReference>(
                "createDomPointerCaptureObserver",
                _componentLifetime.Token,
                DomId("issues-panel-header"));
            await pointerCapture.InvokeVoidAsync("start", _componentLifetime.Token);
            _issuesPanelPointerCapture = pointerCapture;
            return;
        }

        if (_issuesPanelPointerCapture is { } existing)
        {
            _issuesPanelPointerCapture = null;
            await existing.InvokeVoidAsync("dispose", _componentLifetime.Token);
            await existing.DisposeAsync();
        }
    }

    private (double Width, double Height) CurrentIssuesPanelSurface() =>
        _state?.SurfaceSize is { } surfaceSize
            ? (surfaceSize.CssWidth, surfaceSize.CssHeight)
            : (
                FloatingIssuesPanelState.PreferredWidth +
                    (FloatingIssuesPanelState.DefaultMargin * 2d),
                FloatingIssuesPanelState.PreferredHeight +
                    (FloatingIssuesPanelState.DefaultMargin * 2d));

    private static bool IsCurrentPropertiesTarget(
        DocumentCanvasHostState state,
        DocumentCanvasPropertySnapshot target) =>
        state.PropertiesFormOpen &&
        state.Session is { IsClosed: false } session &&
        (target.VisualStateId is { } targetVisualStateId
            ? state.PropertiesTargetVisualStateId == targetVisualStateId &&
              state.PropertiesTargetSemanticElementId is null &&
              session.EditorState.Selection.Contains(targetVisualStateId) &&
              session.CurrentScene?.GetVisualRegion(targetVisualStateId)?.Id ==
                  target.SpatialRegion?.Id
            : state.PropertiesTargetVisualStateId is null &&
              state.PropertiesTargetSemanticElementId == target.SemanticId &&
              session.EditorState.Selection.IsEmpty &&
              session.EditorState.SemanticSceneSelection == target.SemanticId);

    private Task UndoAsync() => ExecuteHistoryOperationAsync(isUndo: true);

    private Task RedoAsync() => ExecuteHistoryOperationAsync(isUndo: false);

    private Task ZoomOutAsync() => ExecuteZoomOperationAsync(
        static (host, cancellationToken) => host.ZoomOutAsync(cancellationToken));

    private Task SetZoomToActualSizeAsync() => ExecuteZoomOperationAsync(
        static (host, cancellationToken) =>
            host.SetZoomToActualSizeAsync(cancellationToken));

    private Task ZoomInAsync() => ExecuteZoomOperationAsync(
        static (host, cancellationToken) => host.ZoomInAsync(cancellationToken));

    private async Task ExecuteHistoryOperationAsync(bool isUndo)
    {
        DocumentCanvasHost? host;
        lock (_lifecycleSync)
        {
            if (_disposed)
            {
                return;
            }

            host = _host;
        }

        if (host is null)
        {
            return;
        }

        if (isUndo)
        {
            await host.UndoAsync(_componentLifetime.Token);
        }
        else
        {
            await host.RedoAsync(_componentLifetime.Token);
        }

        lock (_lifecycleSync)
        {
            if (!_disposed && ReferenceEquals(_host, host))
            {
                _state = host.CaptureState();
            }
        }
    }

    private async Task ExecuteZoomOperationAsync(
        Func<DocumentCanvasHost, CancellationToken, ValueTask> operation)
    {
        ArgumentNullException.ThrowIfNull(operation);
        DocumentCanvasHost? host;
        lock (_lifecycleSync)
        {
            if (_disposed)
            {
                return;
            }

            host = _host;
        }

        if (host is null)
        {
            return;
        }

        await operation(host, _componentLifetime.Token);
        lock (_lifecycleSync)
        {
            if (!_disposed && ReferenceEquals(_host, host))
            {
                _state = host.CaptureState();
            }
        }
    }

    private static string Format(double? value) => value?.ToString(
        "0.###",
        System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;

    private static string FormatBounds(RectD bounds) => string.Join(",",
        Format(bounds.X),
        Format(bounds.Y),
        Format(bounds.Width),
        Format(bounds.Height));

    private string ValidationTargetLabel(ModelValidationTarget target)
    {
        ArgumentNullException.ThrowIfNull(target);
        if (target.VisualStateId is { } visualStateId)
        {
            return Text["Target_VisualSemantic", visualStateId.Value, target.SemanticElementId!.Value];
        }

        return target.SemanticElementId is { } semanticElementId
            ? Text["Target_Semantic", semanticElementId.Value]
            : Text["Target_Document"];
    }

    private enum PropertiesVisualDraftField
    {
        X,
        Y,
        Width,
        Height,
    }

    private string ResolveSemanticElementId(
        Inceptus.DocumentEngine.Contracts.Primitives.SceneObjectId? sceneObjectId)
    {
        if (sceneObjectId is null || _state?.Session?.CurrentScene is not { } scene)
        {
            return string.Empty;
        }

        return scene.Items.FirstOrDefault(item => item.Id == sceneObjectId)
            ?.Origin.SemanticElementId?.Value ?? string.Empty;
    }

    private Inceptus.DocumentEngine.Contracts.Primitives.VisualStateId?
        ResolveSelectedVisualStateId()
    {
        return _state?.Session?.EditorState.Selection.FirstOrDefault();
    }

    private Canvas2DSceneItem? ResolveSelectedSceneObject()
    {
        var visualStateId = ResolveSelectedVisualStateId();
        var session = _state?.Session;
        var scene = session?.CurrentScene;
        return visualStateId is null || scene is null
            ? null
            : scene.Items.FirstOrDefault(item =>
                item.Layer is Canvas2DSceneLayer.Content or Canvas2DSceneLayer.Connector &&
                item.Origin.VisualStateId == visualStateId);
    }

    private Canvas2DSceneItem? ResolveSelectedPersistentItem(bool preferPath)
    {
        var visualStateId = ResolveSelectedVisualStateId();
        var session = _state?.Session;
        var scene = session?.CurrentScene;
        if (visualStateId is null || scene is null)
        {
            return null;
        }

        var items = scene.Items.Where(item =>
            item.Layer is Canvas2DSceneLayer.Content or Canvas2DSceneLayer.Connector &&
            item.Origin.VisualStateId == visualStateId);
        return preferPath
            ? items.FirstOrDefault(item => item.Geometry.Kind == Canvas2DSceneGeometryKind.Path)
            : items.FirstOrDefault(item => item.Geometry.Kind is
                Canvas2DSceneGeometryKind.Rectangle or Canvas2DSceneGeometryKind.Ellipse)
                ?? items.FirstOrDefault();
    }
}
