    private async Task ConfirmNewDiagramAsync()
    {
        DocumentCanvasHost? host;
        lock (_lifecycleSync)
        {
            if (_disposed || !_newDiagramConfirmationOpen || _newDiagramInProgress)
            {
                return;
            }

            host = _host;
            _newDiagramConfirmationOpen = false;
            _newDiagramConfirmationFocusPending = false;
            _newDiagramInProgress = true;
            ClearNewDiagramOperationError();
            _newDiagramOperationStatus = "creating";
        }

        await InvokeAsync(StateHasChanged);
        try
        {
            if (host is null)
            {
                CompleteNewDiagramOperation(
                    "CANVAS_NEW_DIAGRAM_UNAVAILABLE",
                    "Error_NewUnavailable");
                return;
            }

            var result = await host.NewDiagramAsync(_componentLifetime.Token);
            if (result.Status == NewDiagramHostOperationStatus.Cancelled)
            {
                return;
            }
            if (!result.Succeeded)
            {
                var diagnostic = result.Diagnostics.FirstOrDefault();
                CompleteNewDiagramOperation(
                    diagnostic?.Code ?? "CANVAS_NEW_DIAGRAM_FAILED",
                    "Error_NewFailed");
                return;
            }

            lock (_lifecycleSync)
            {
                if (_disposed || !ReferenceEquals(_host, host))
                {
                    return;
                }

                _state = host.CaptureState();
                _propertiesDraft = null;
                _modelViewPropertiesDraft = null;
                _propertiesApplying = false;
                _propertiesApplyStatus = "idle";
                _modelViewPropertiesApplying = false;
                _modelViewPropertiesApplyStatus = "idle";

                ClearNewDiagramOperationError();
                _newDiagramOperationStatus = "idle";
            }
        }
        catch (OperationCanceledException) when (_componentLifetime.IsCancellationRequested)
        {
            // Component disposal cancels replacement without surfacing a stale message.
        }
#pragma warning disable CA1031 // Browser host failures become bounded operation messages.
        catch (Exception exception) when (IsNonFatalEditorException(exception))
        {
            CompleteNewDiagramOperation(
                "CANVAS_NEW_DIAGRAM_FAILED",
                "Error_NewFailed");
        }
#pragma warning restore CA1031
        finally
        {
            lock (_lifecycleSync)
            {
                _newDiagramInProgress = false;
                if (!_disposed && _newDiagramOperationStatus == "creating")
                {
                    _newDiagramOperationStatus = "idle";
                }
            }
        }
    }

    private void CompleteNewDiagramOperation(string code, string message)
    {
        lock (_lifecycleSync)
        {
            if (_disposed)
            {
                return;
            }

            _newDiagramOperationErrorCode = code;
            _newDiagramOperationErrorMessage = message;
            _newDiagramOperationStatus = "failed";
        }
    }

    private void ClearNewDiagramOperationError()
    {
        _newDiagramOperationErrorCode = null;
        _newDiagramOperationErrorMessage = null;
    }

    private async Task FocusNewDiagramConfirmationAsync()
