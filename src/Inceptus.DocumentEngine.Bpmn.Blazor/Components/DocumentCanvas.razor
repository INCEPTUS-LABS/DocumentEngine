    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            DocumentCanvasHost host;
            lock (_lifecycleSync)
            {
                if (_disposed || _host is not null)
                {
                    return;
                }

                host = new DocumentCanvasHost(
                    JavaScript,
                    CompositionFactory,
                    _toolboxSelection);
                host.StateChanged += HandleHostStateChangedAsync;
                ModelerFacade?.Attach(host);
                _host = host;
            }

            await host.InitializeAsync(
                CanvasElementId,
                StandbyCanvasElementId,
                ContainerElementId,
                _componentLifetime.Token);
            await InvokeAsync(() =>
            {
                lock (_lifecycleSync)
                {
                    if (_disposed || !ReferenceEquals(_host, host))
                    {
                        return;
                    }

                    _state = host.CaptureState();
                }

                SynchronizeIssuesPanelSurface();
                StateHasChanged();
            });
        }

        await SynchronizeIssuesPanelPointerCaptureAsync();
        await FocusNewDiagramConfirmationAsync();
        await FocusPublicationDialogAsync();
    }

    public async ValueTask DisposeAsync()
    {
        DocumentCanvasHost? host;
        lock (_lifecycleSync)
        {
            if (_disposed)
            {
                return;
            }

            _disposed = true;
            _componentLifetime.Cancel();
            _propertiesDraft = null;
            _modelViewPropertiesDraft = null;
            _newDiagramConfirmationOpen = false;
            _newDiagramConfirmationFocusPending = false;
            DiscardPublicationDialogDraft();
            _issuesPanel.CancelMove();
            host = _host;
            _host = null;
            if (host is not null)
            {
                host.StateChanged -= HandleHostStateChangedAsync;
            }
        }

        if (host is not null)
        {
            await host.DisposeAsync();
        }

        if (_issuesPanelPointerCapture is { } issuesPanelPointerCapture)
        {
            await issuesPanelPointerCapture.InvokeVoidAsync("dispose");
            await issuesPanelPointerCapture.DisposeAsync();
            _issuesPanelPointerCapture = null;
        }

        if (_issuesPanelModule is { } issuesPanelModule)
        {
            await issuesPanelModule.DisposeAsync();
            _issuesPanelModule = null;
        }

        _componentLifetime.Dispose();
    }

    private Task HandleHostStateChangedAsync() => InvokeAsync(() =>
    {
        lock (_lifecycleSync)
        {
            if (_disposed || _host is null)
            {
                return;
