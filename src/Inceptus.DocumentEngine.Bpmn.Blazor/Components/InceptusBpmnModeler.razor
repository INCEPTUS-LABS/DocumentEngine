         style="@Style"
         @attributes="AdditionalAttributes">
        <CascadingValue Name="ModelerUICulture" Value="CultureInfo.CurrentUICulture">
            <DocumentCanvas />
        </CascadingValue>
    </div>
</CascadingValue>
