@namespace Inceptus.DocumentEngine.Bpmn.Blazor.Components
@using Inceptus.DocumentEngine.Bpmn.Blazor.Presentation
@using System.Globalization

<CascadingValue Value="_facade" IsFixed="true">
    <div class="@RootClass"
         style="@Style"
         data-display-mode="@_displayMode.ToString().ToLowerInvariant()"
         @attributes="AdditionalAttributes">
        <CascadingValue Name="ModelerUICulture" Value="CultureInfo.CurrentUICulture">
            <CascadingValue Value="DisplayPresentation">
                <DocumentCanvas @ref="_canvas" />
            </CascadingValue>
        </CascadingValue>
    </div>
</CascadingValue>
