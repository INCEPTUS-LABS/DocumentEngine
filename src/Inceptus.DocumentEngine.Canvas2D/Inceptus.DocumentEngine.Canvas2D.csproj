<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <PackageId>Inceptus.DocumentEngine.Canvas2D</PackageId>
    <AssemblyName>Inceptus.DocumentEngine.Canvas2D</AssemblyName>
    <RootNamespace>Inceptus.DocumentEngine.Canvas2D</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>Canvas2D browser editing session, interaction, scene, and renderer integration for the Inceptus Document Engine.</Description>
    <PackageTags>inceptus;document-engine;canvas2d;browser</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.JSInterop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Inceptus.DocumentEngine.Contracts/Inceptus.DocumentEngine.Contracts.csproj" />
    <ProjectReference Include="../Inceptus.DocumentEngine.Runtime/Inceptus.DocumentEngine.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Publishing/Assets/index.html"
                      LogicalName="Inceptus.DocumentEngine.Canvas2D.Publishing.index.html" />
    <EmbeddedResource Include="Publishing/Assets/inceptus.publish.js"
                      LogicalName="Inceptus.DocumentEngine.Canvas2D.Publishing.inceptus.publish.js" />
    <EmbeddedResource Include="Publishing/Assets/styles.css"
                      LogicalName="Inceptus.DocumentEngine.Canvas2D.Publishing.styles.css" />
  </ItemGroup>
  <!-- NuGet pack collects referenced project versions from the assets graph. Only this
       friend-assembly dependency requires a matching version; retain all other ranges. -->
  <Target Name="ConstrainRuntimePackageDependency" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)"
                                      Condition="'%(_ProjectReferencesWithVersions.Filename)' == 'Inceptus.DocumentEngine.Runtime'">
        <ProjectVersion>[$(PackageVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>
</Project>
